# 必須: そーCloud 本体として動く Discord Bot のトークン
DISCORD_TOKEN=

# 管理者として扱う Discord User ID（カンマ区切り）
ADMIN_IDS=

# サイト
SITE_HOST=0.0.0.0
SITE_PORT=8080
PUBLIC_URL=http://localhost:8080
CLOUDFLARE_DOMAIN=
CLOUDFLARE_ENABLED=false
CLOUDFLARE_TUNNEL=false
TRUST_PROXY=false

# Discord OAuth2（Web ログインを使う場合）
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
OAUTH_REDIRECT_URI=

# 制限・タイムアウト
MAX_BOTS_PER_USER=5
INSTALL_TIMEOUT_SEC=180
RUNTIME_INSTALL_TIMEOUT_SEC=900
